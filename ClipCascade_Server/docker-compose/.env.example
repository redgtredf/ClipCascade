# ClipCascade Server — required environment variables.
# Copy this file to '.env' (same folder as your docker-compose file) and fill
# in real values. The server refuses to start when any of these is missing.

# Initial admin account. Created ONLY when the user database is empty.
# There is no default; choose a strong password (never 'admin123').
CC_ADMIN_USERNAME=admin
CC_ADMIN_PASSWORD=

# Password for the user database.
# H2 (default): '<file password> <user password>' — two space-separated
# secrets. PostgreSQL deployments: the database password (see
# docker-compose-multi-users.yml, where it is shared with the postgres
# service). Once set, the same value is required to migrate the database.
CC_SERVER_DB_PASSWORD=

# Comma-separated origins allowed to reach the WebSocket / dashboard,
# e.g. http://localhost:8080 or https://clipcascade.example.com.
# Wildcards ('*') are refused in production.
CC_ALLOWED_ORIGINS=

# Only needed for docker-compose-stomp-external-broker.yml.
# Must match the ActiveMQ admin login configured in that file.
CC_BROKER_USERNAME=
CC_BROKER_PASSWORD=
